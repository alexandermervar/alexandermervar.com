---
import BaseLayout from '../layouts/BaseLayout.astro';
import MastodonFeed from '../components/MastodonFeed.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---

<BaseLayout title="Alexander Mervar" description="Writing about history, psychology, film, and whatever else is on my mind.">
  <h1>Alexander Mervar</h1>
  <p>Writing about history, psychology, film, and whatever else I'm thinking about.</p>
  <p class="post-meta">
    <a href="https://letterboxd.com/macDoofOS/" rel="me noopener" target="_blank">Letterboxd</a> &middot;
    <a href="https://hachyderm.io/@macDoofOS" rel="me noopener" target="_blank">Mastodon</a>
  </p>

  {posts.length > 0 && (
    <>
      <h2>Recent posts</h2>
      <ul class="post-list">
        {posts.map(post => (
          <li>
            <p class="post-meta">
              {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </p>
            <p class="post-title">
              <a href={`/blog/${post.id}`}>{post.data.title}</a>
            </p>
            <p class="post-description">{post.data.description}</p>
          </li>
        ))}
      </ul>
      <p><a href="/blog">All posts &rarr;</a></p>
    </>
  )}

  <MastodonFeed />
</BaseLayout>
