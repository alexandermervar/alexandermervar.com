---
export interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  containerClass?: string;
}

const { title, description = 'Writing about history, psychology, film, and whatever else is on my mind.', canonicalUrl, containerClass } = Astro.props;
const siteUrl = 'https://alexandermervar.com';
const canonical = canonicalUrl ?? `${siteUrl}${Astro.url.pathname}`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Alexander Mervar" />

    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Alexander Mervar" />
    <meta property="og:image" content={`${siteUrl}/images/about.jpg`} />
    <meta property="og:image:alt" content="Alexander Mervar" />

    <title>{title}</title>

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- RSS autodiscovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Alexander Mervar — Blog"
      href={`${siteUrl}/rss.xml`}
    />

    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class={`container${containerClass ? ' ' + containerClass : ''}`}>
      <header class="site-header">
        <nav aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/about">About</a>
          <a href="/blog">Blog</a>
          <a href="/projects">Projects</a>
          <a href="/resume">Résumé</a>
          <a href="/rss.xml">RSS</a>
        </nav>
      </header>
      <main id="main">
        <slot />
      </main>

      <footer>
        <p>
          <a href="https://letterboxd.com/macDoofOS/" rel="me noopener" target="_blank">Letterboxd</a> &middot;
          <a href="https://hachyderm.io/@macDoofOS" rel="me noopener" target="_blank">Mastodon</a>
        </p>
        <p>
          &copy; {new Date().getFullYear()} Alexander Mervar &mdash;
          <a href="/rss.xml">RSS</a>
        </p>
      </footer>
    </div>
  </body>
</html>
