---
import BaseLayout from '../layouts/BaseLayout.astro';

const lastUpdated = 'June 2026';

const experience = [
  {
    company: 'Impact Advisors',
    title: 'Senior Consultant',
    meta: 'Feb 2026 – Present · Chicago, IL (Remote)',
    points: [
      "Helped stand up the firm's Workday AMS practice from the ground up — shaping how a young practice intakes, triages, staffs, and delivers client requests.",
      'Serve as client advisor across AMS engagements (10+ supported over my career), owning the client relationship and routing incoming work to the right functional leaders.',
      'Built the internal documentation, SOPs, and workflows that keep delivery on track and meet request-turnaround commitments.',
      'Led management of the Workday 2026R1 release for AMS clients; hosted public-facing webinars for customers and partners (~30 attendees each) and an enablement lunch-and-learn on Object Transporter (OX).',
      'Co-led integrations office hours for the nearshore delivery team, raising delivery consistency and unblocking work.',
    ],
  },
  {
    company: 'Impact Advisors',
    title: 'Consultant',
    meta: 'Aug 2023 – Feb 2026 · Chicago, IL (Remote)',
    points: [
      'Led Workday configuration, integration, and reporting initiatives for large healthcare organizations; contributed to 5+ implementations and built a large library of Core Connector integrations and EIBs.',
      'Coordinated downstream integration testing across Symplr, PayScale, HealthStream, CBiz, and Strata (5 systems) for the Emory go-live; led Emory job-profile consolidation.',
      "Built an internal integration analytics tool and authored ~5 SOPs (3 published) that became the practice's reference material for request intake and delivery.",
      'Managed error-queue resolution, tenant build audits, and change readiness to streamline post-production support and ensure governance compliance.',
    ],
  },
  {
    company: 'Abbott Laboratories',
    title: 'IT Intern',
    meta: 'May 2022 – Aug 2022 · Lake County, IL',
    points: [
      'Project-managed an internal automation initiative; gathered requirements for a mobile-app prototype and facilitated Lean / Six Sigma workshops. Presented an internal training webinar to an audience of ~1,000 employees.',
    ],
  },
  {
    company: 'Indiana University, UITS',
    title: 'Consultant Supervisor',
    meta: 'Nov 2019 – May 2023 · Bloomington, IN',
    points: [
      'Supervised 5–10 consultants per shift across 58 campus computer labs; trained staff on hardware/software troubleshooting. Awarded Consultant of the Month.',
    ],
  },
];

const skills = [
  'Workday', 'Application Management Services (AMS)', 'Client Advisory',
  'Business Process Improvement', 'Workday Integration', 'Project Management',
  'Stakeholder Management', 'Reporting', 'SLA / Service Management',
  'Python', 'Java', 'XSLT', 'Git', 'Docker',
];

const projects = [
  { name: 'agent-manager', url: 'https://github.com/alexandermervar/agent-manager', desc: 'Python CLI for running multiple AI agents (YAML config, SQLite task queue, parallel execution via the Anthropic SDK). Open source.' },
  { name: 'HAL-1000', url: null, desc: 'Raspberry Pi homelab on Docker: Pi-hole, Traefik, Portainer, and a self-written Letterboxd-to-Mastodon bot.' },
  { name: 'alexandermervar.com', url: null, desc: 'This site — built with Astro, deployed on Netlify; zero client-side JavaScript.' },
];
---

<BaseLayout title="Résumé — Alexander Mervar" description="Résumé of Alexander Mervar — Workday AMS, integrations, and client advisory consultant.">
  <div class="resume-head">
    <h1>Résumé</h1>
    <a class="download" href="/Alexander-Mervar-Resume.pdf" download>Download PDF</a>
  </div>
  <p class="resume-tagline">Technology Consultant — Workday AMS, Integrations &amp; Client Advisory</p>
  <p class="resume-meta">Last updated {lastUpdated}. The PDF above is the version I send for specific roles. Get in touch via the <a href="/about">About</a> page.</p>

  <p>I'm a consultant in the Workday ecosystem, working where client advisory meets hands-on delivery. Over three years I've advised 10+ AMS engagements, contributed to 5+ Workday implementations, and built a large library of Core Connector and EIB integrations. I helped stand up an Application Management Services (AMS) practice from the ground up — advising clients and designing the internal systems and workflows that keep delivery on track. I'm equally at home in front of clients, in delivery, and building the tooling underneath it all.</p>

  <h2>Experience</h2>
  {experience.map((role) => (
    <div class="entry">
      <p class="entry-title">{role.company} — {role.title}</p>
      <p class="entry-meta">{role.meta}</p>
      <ul>
        {role.points.map((pt) => <li>{pt}</li>)}
      </ul>
    </div>
  ))}

  <h2>Skills</h2>
  <ul class="tags">
    {skills.map((s) => <li class="tag">{s}</li>)}
  </ul>

  <h2>Certifications</h2>
  <p><strong>Workday Certified</strong> — Integration, Studio, Orchestrate, Reporting, Launch, and Project Management (6 certifications) · <strong>Smartsheet</strong> — Core &amp; Project Management.</p>

  <h2>Projects</h2>
  <ul class="post-list">
    {projects.map((p) => (
      <li>
        <p class="post-title">{p.url ? <a href={p.url} target="_blank" rel="noopener">{p.name}</a> : p.name}</p>
        <p class="post-description">{p.desc}</p>
      </li>
    ))}
  </ul>

  <h2>Education</h2>
  <p><strong>Indiana University Bloomington</strong> — B.S. Cognitive Science, Minor in Business · May 2023. Undergraduate research: <em>Agent-Based Models and Disease Transmission.</em></p>
</BaseLayout>

<style>
  .resume-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .resume-head h1 { margin-bottom: 0; }
  .download {
    font-family: var(--font-ui);
    font-size: 0.85rem;
    text-decoration: none;
    border: 1px solid var(--ink);
    padding: 0.4rem 0.9rem;
    color: var(--ink);
    white-space: nowrap;
  }
  .download:hover { background: var(--ink); color: var(--paper); }

  .resume-tagline {
    font-family: var(--font-ui);
    font-weight: 600;
    margin: 0.4rem 0 0.2rem;
  }
  .resume-meta {
    font-family: var(--font-ui);
    font-size: 0.85rem;
    color: var(--ink-muted);
    margin-bottom: 1.5rem;
  }

  .entry { margin-bottom: 1.25rem; }
  .entry-title {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 1.02rem;
    margin: 0;
  }
  .entry-meta {
    font-family: var(--font-ui);
    font-size: 0.82rem;
    color: var(--ink-muted);
    margin: 0.1rem 0 0.4rem;
  }
  .entry ul { margin: 0; padding-left: 1.1rem; }
  .entry li { margin-bottom: 0.3rem; }

  ul.tags { margin-top: 0.5rem; }
</style>
