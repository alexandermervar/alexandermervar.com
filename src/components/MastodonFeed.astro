---
// MastodonFeed.astro — compact sidebar widget
const { instance = 'hachyderm.io', username = 'macDoofOS', limit = 4 } = Astro.props;
---

<aside class="sidebar" aria-label="Recent Mastodon posts">
  <p class="sidebar-label">On Mastodon</p>
  <ul class="sidebar-posts" id="mastodon-posts">
    <li class="sidebar-loading">Loading…</li>
  </ul>
  <p class="sidebar-footer">
    <a href={`https://${instance}/@${username}`} target="_blank" rel="me noopener">
      @{username}@{instance} &rarr;
    </a>
  </p>
</aside>

<script define:vars={{ instance, username, limit }}>
  (async () => {
    const list = document.getElementById('mastodon-posts');
    if (!list) return;

    // Extract a YouTube video ID from a string if present
    function youtubeId(text) {
      const m = text.match(
        /(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([A-Za-z0-9_-]{11})/
      );
      return m ? m[1] : null;
    }

    // Strip HTML, returning plain text
    function stripHtml(html) {
      const div = document.createElement('div');
      div.innerHTML = html;
      div.querySelectorAll('br').forEach(el => el.replaceWith('\n'));
      div.querySelectorAll('p').forEach(el => el.after('\n'));
      return div.textContent.trim();
    }

    try {
      const lookupRes = await fetch(
        `https://${instance}/api/v1/accounts/lookup?acct=${username}`
      );
      if (!lookupRes.ok) throw new Error();
      const { id } = await lookupRes.json();

      const statusRes = await fetch(
        `https://${instance}/api/v1/accounts/${id}/statuses` +
        `?limit=${limit}&exclude_replies=true&exclude_reblogs=true`
      );
      if (!statusRes.ok) throw new Error();
      const statuses = await statusRes.json();

      if (!statuses.length) {
        list.innerHTML = '<li class="sidebar-empty">No recent posts.</li>';
        return;
      }

      list.innerHTML = statuses.map(s => {
        const text = stripHtml(s.content);
        const date = new Date(s.created_at).toLocaleDateString('en-US', {
          month: 'short', day: 'numeric'
        });

        // Check for a YouTube link in both the post text and any card attached
        const fullText = text + ' ' + (s.card?.url || '');
        const ytId = youtubeId(fullText);

        const ytEmbed = ytId
          ? `<div class="sidebar-yt">
               <a href="https://www.youtube.com/watch?v=${ytId}" target="_blank" rel="noopener">
                 <img
                   src="https://img.youtube.com/vi/${ytId}/mqdefault.jpg"
                   alt="YouTube video"
                   loading="lazy"
                   width="320" height="180"
                   class="sidebar-yt-thumb"
                 />
               </a>
             </div>`
          : '';

        return `
          <li>
            <p class="sidebar-date">${date}</p>
            <p class="sidebar-text">${text}</p>
            ${ytEmbed}
            <a class="sidebar-link" href="${s.url}" target="_blank" rel="noopener">View post &rarr;</a>
          </li>
        `;
      }).join('');

    } catch {
      list.innerHTML =
        `<li class="sidebar-empty">
           <a href="https://${instance}/@${username}" target="_blank" rel="noopener">
             See posts on Mastodon &rarr;
           </a>
         </li>`;
    }
  })();
</script>

<style>
  .sidebar-yt {
    margin: 0.4rem 0 0.3rem;
  }

  .sidebar-yt-thumb {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--rule);
  }
</style>
