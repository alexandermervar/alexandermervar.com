---
import BaseLayout from '../layouts/BaseLayout.astro';
import MastodonFeed from '../components/MastodonFeed.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---

<BaseLayout
  title="Alexander Mervar"
  description="Alexander Mervar — essays and film criticism, published independently."
  containerClass="container--home"
>
  <h1>Alexander Mervar</h1>
  <p class="lede">I write essays and film criticism. This is where it's published — independently, for the people who want to read it.</p>
  <p class="post-meta">
    <a href="/subscribe">Subscribe</a> &middot;
    <a href="https://letterboxd.com/macDoofOS/" rel="me noopener" target="_blank">Letterboxd</a> &middot;
    <a href="https://hachyderm.io/@macDoofOS" rel="me noopener" target="_blank">Mastodon</a>
  </p>

  <div class="home-grid">
    <div class="home-main">
      {posts.length > 0 && (
        <>
          <h2>Recent writing</h2>
          <ul class="post-list">
            {posts.map(post => (
              <li>
                <p class="post-meta">
                  {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                </p>
                <p class="post-title">
                  <a href={`/blog/${post.id}`}>{post.data.title}</a>
                </p>
                <p class="post-description">{post.data.description}</p>
              </li>
            ))}
          </ul>
          <p><a href="/blog">All writing &rarr;</a></p>
        </>
      )}
    </div>

    <MastodonFeed />
  </div>
</BaseLayout>

<style>
  .lede {
    font-size: 1.12rem;
    color: var(--ink);
    max-width: 36rem;
  }
</style>
